  "feature_definitions": {
    "event_id": "random unique id (no label information)",
    "timestamp": "ISO 8601 send time",
    "date": "YYYY-MM-DD",
    "hour": "0-23",
    "day_of_week": "Monday..Sunday",
    "is_weekend": "1 on Sat/Sun",
    "is_after_hours": "1 if hour<8 or hour>=18",
    "username": "synthetic employee id (identifier, not a predictor)",
    "department": "employee department (context)",
    "role": "employee role (context)",
    "recipient_count": "distinct To/CC/BCC recipients",
    "external_recipient": "1 if any recipient external",
    "attachment_count": "attachments in the email",
    "size": "email size in bytes",
    "word_count": "body words (metadata only)",
    "char_count": "body characters (metadata only)",
    "sentence_count": "body sentences (metadata only)",
    "activity_frequency_1h": "employee's emails in [t-1h, t), strictly earlier events",
    "activity_frequency_24h": "employee's emails in [t-24h, t)",
    "unique_recipients_24h": "distinct recipients across those 24h emails",
    "off_hours_events_7d": "after-hours emails in [t-7d, t)",
    "external_recipient_events_7d": "emails with external recipients in [t-7d, t)",
    "label": "normal | suspicious (target)",
    "threat_scenario": "evaluation/analysis only - never a predictor",
    "split": "train | validation | test (employee-disjoint)"
  },
  "assumptions_and_limitations": [
    "All data is synthetic. Suspicious behavior is defined by the six rules in this script (hours, volume, recipients, external, attachments, combined) and mirrors my assumptions, not observed attacks.",
    "Rolling features are computed on each employee's full simulated stream (including normal events not kept in the final CSV) using only earlier events, so counts reflect true activity, not the sampled subset.",
    "Normal rows are a weighted sample that over-represents legitimate hard cases (after-hours, weekend, external, large attachments, broadcasts, bursts) so no single feature is a shortcut.",
    "Suspicious episode strength is randomized, so some suspicious events are only mildly abnormal and overlap normal behavior; this is intended.",
    "Every employee has both classes, so identity cannot reveal the label; splits are by employee for unseen-employee evaluation.",
    "Good scores here show the pipeline works, not that the model would detect real insiders."
  ]
}